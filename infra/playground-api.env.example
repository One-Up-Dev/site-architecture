# Copier dans /etc/playground-api.env (chmod 640, root:playground)
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Obligatoire : openssl rand -hex 32
COOKIE_SECRET=
# Capacité : 2 sur un VPS de 2 Go ; à augmenter avec la RAM (≈ 1 par 512 Mo libres)
MAX_PLAYGROUNDS=2
TTL_MIN=30
WARN_BEFORE_MIN=2
CREATE_PER_HOUR=5
# Mettre 1 une fois HTTPS activé (cookie envoyé seulement en HTTPS)
SECURE_COOKIE=0
